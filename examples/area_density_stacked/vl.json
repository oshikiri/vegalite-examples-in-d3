{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Stacked density estimates of car horsepower by origin.",
  "width": 400,
  "height": 200,
  "data": { "url": "../../data/cars.json" },
  "transform": [
    {
      "density": "Horsepower",
      "groupby": ["Origin"],
      "extent": [40, 200],
      "bandwidth": 15
    }
  ],
  "mark": "area",
  "encoding": {
    "x": {
      "field": "value",
      "type": "quantitative",
      "title": "Horsepower"
    },
    "y": {
      "field": "density",
      "type": "quantitative",
      "stack": "zero",
      "title": "Density"
    },
    "color": {
      "field": "Origin",
      "type": "nominal",
      "legend": { "title": null }
    }
  }
}
